{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "description": "Processador distribuído de transações de apostas — desafio técnico Jungle Gaming",
  "scripts": {
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch run src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 150000",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration --timeout 90000",
    "test:concurrency": "bun test test/concurrency --timeout 150000",
    "migration:up": "bun run scripts/migrate.ts up",
    "migration:down": "bun run scripts/migrate.ts down",
    "migration:reset": "bun run scripts/migrate.ts reset",
    "infra:up": "docker compose up -d postgres localstack",
    "infra:down": "docker compose down -v"
  },
  "mikro-orm": {
    "useTsNode": false,
    "configPaths": [
      "./src/infrastructure/persistence/mikro-orm.config.ts"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.700.0",
    "@mikro-orm/cli": "^6.4.0",
    "@mikro-orm/core": "^6.4.0",
    "@mikro-orm/migrations": "^6.4.0",
    "@mikro-orm/nestjs": "^6.1.0",
    "@mikro-orm/postgresql": "^6.4.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "decimal.js": "^10.4.3",
    "nestjs-pino": "^4.1.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/express": "^5.0.0",
    "typescript": "^5.6.3"
  }
}
